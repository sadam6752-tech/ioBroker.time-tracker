{
	"i18n": true,
	"type": "tabs",
	"items": {
		"general": {
			"type": "panel",
			"label": "General",
			"items": {
				"_firstStartHint": {
					"type": "staticText",
					"text": "⚠️ First start: the first administrator is created when the instance starts for the first time. If the password field stays empty, the generated password is written ONCE into the ioBroker log (open “Logs” on the left, look for the yellow line with “created with the start password”) — both fields are in the tab “Migration and backup”. The app asks for a new password at the first login.",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"port": {
					"type": "number",
					"label": "Port",
					"help": "the port of the web app, the API and the terminal; 8082 stays free for vis and web",
					"min": 1,
					"max": 65535,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"bind": {
					"type": "ip",
					"listenOnAllPorts": true,
					"label": "Bind address",
					"help": "127.0.0.1 = only this machine",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"timezone": {
					"type": "text",
					"label": "Instance time zone",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"defaultLanguage": {
					"type": "select",
					"label": "Default language for new users",
					"options": [
						{ "label": "English", "value": "en" },
						{ "label": "Deutsch", "value": "de" },
						{ "label": "Русский", "value": "ru" },
						{ "label": "Português", "value": "pt" },
						{ "label": "Nederlands", "value": "nl" },
						{ "label": "Français", "value": "fr" },
						{ "label": "Italiano", "value": "it" },
						{ "label": "Español", "value": "es" },
						{ "label": "Polski", "value": "pl" },
						{ "label": "Українська", "value": "uk" },
						{ "label": "中文", "value": "zh-cn" }
					],
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"holidayCountry": {
					"type": "select",
					"label": "Holiday country",
					"options": [
						{ "label": "Switzerland", "value": "CH" },
						{ "label": "Germany", "value": "DE" },
						{ "label": "Austria", "value": "AT" }
					],
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"dbPath": {
					"type": "text",
					"label": "Database file (empty = adapter data directory)",
					"xs": 12,
					"sm": 12,
					"md": 8,
					"lg": 6,
					"xl": 6
				},
				"kioskEnabled": {
					"type": "checkbox",
					"label": "Enable kiosk terminal",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				}
			}
		},
		"security": {
			"type": "panel",
			"label": "Security",
			"items": {
				"sessionSecret": {
					"type": "password",
					"label": "Session secret",
					"help": "empty = the adapter generates one once and stores it next to the database, so sessions survive restarts",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"hmacSecret": {
					"type": "password",
					"label": "Badge link secret (HMAC)",
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"sessionTtlMinutes": {
					"type": "number",
					"label": "Session lifetime in minutes",
					"min": 5,
					"max": 43200,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 2,
					"xl": 2
				},
				"editWindowDays": {
					"type": "number",
					"label": "Days users may edit on their own",
					"min": 0,
					"max": 365,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 2,
					"xl": 2
				},
				"trustProxy": {
					"type": "checkbox",
					"label": "Trust the reverse proxy (X-Forwarded-*)",
					"help": "only switch this on when a reverse proxy is in front of the adapter",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				}
			}
		},
		"rules": {
			"type": "panel",
			"label": "Time rules",
			"items": {
				"quickRoundMinutes": {
					"type": "number",
					"label": "Round quick punches to minutes (0 = off)",
					"min": 0,
					"max": 60,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"absenceCalcUntilToday": {
					"type": "checkbox",
					"label": "Calculate absences only until today",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"absenceDeductWorktime": {
					"type": "checkbox",
					"label": "Subtract working time from absences",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				}
			}
		},
		"backup": {
			"type": "panel",
			"label": "Migration and backup",
			"items": {
				"_adminHintHeader": {
					"type": "header",
					"text": "First start: the start password is in the ioBroker log",
					"size": 4,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"_adminHint": {
					"type": "staticText",
					"text": "⚠️ The account of the first administrator is created at the very first start. If the password field below stays empty, the adapter generates a random password and writes it ONCE into the ioBroker log: open “Logs” in the ioBroker admin on the left and look for the yellow line with “created with the start password” — that is the password for the first login. The app then asks for a new password right away. Enter your own password below instead if you want to skip that.",
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"adminLogin": {
					"type": "text",
					"label": "Login of the first administrator",
					"help": "used once: the account is created when the instance has no administrator yet",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"adminPassword": {
					"type": "password",
					"label": "Start password of the first administrator",
					"help": "empty = a random password is written to the adapter log once; it has to be changed at the first login",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"backupRetentionDays": {
					"type": "number",
					"label": "Keep database backups for days",
					"min": 0,
					"max": 3650,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 2,
					"xl": 2
				}
			}
		}
	}
}
