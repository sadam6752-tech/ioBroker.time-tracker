{
  "name": "iobroker.zeiterfassung",
  "version": "0.0.1",
  "description": "Time tracking (clock-in/out) for ioBroker with web app, badge terminal and reports",
  "author": {
    "name": "Alex",
    "email": "sadam6752@gmail.com"
  },
  "contributors": [],
  "homepage": "https://github.com/sadam6752-tech/ioBroker.zeiterfassung",
  "license": "MIT",
  "keywords": [
    "time tracking",
    "zeiterfassung",
    "clock in",
    "attendance",
    "working time",
    "pwa",
    "rfid"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sadam6752-tech/ioBroker.zeiterfassung.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "coverage": "nyc npm run test:ts",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server",
    "cleanroom": "pwsh -NoProfile -File tools/cleanroom-check.ps1 -FailOnHit",
    "check:i18n": "pwsh -NoProfile -File tools/check-i18n.ps1 -FailOnIssue",
    "check:i18n:report": "pwsh -NoProfile -File tools/check-i18n.ps1"
  },
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "bugs": {
    "url": "https://github.com/sadam6752-tech/ioBroker.zeiterfassung/issues"
  },
  "readmeFilename": "README.md"
}
